
{
  "entities": {
    "Task": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Task",
      "type": "object",
      "description": "Represents a single task within the NexTask application.",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "constructionType": { "type": "string" },
        "receptionDate": { "type": "string", "format": "date" },
        "dueDate": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["todo", "in_progress", "pending", "awaiting_payment", "done"] },
        "pdfs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "data": { "type": "string" }
            }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "clientId": { "type": "string" }
      },
      "required": ["id", "title", "receptionDate", "dueDate", "status", "createdAt", "updatedAt", "clientId"]
    },
    "Client": {
      "title": "Client",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "color": { "type": "string" },
        "dedicatedUrlIdentifier": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "dedicatedUrlIdentifier", "createdAt", "updatedAt"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous", "google"]
  },
  "firestore": {
    "/clients/{clientId}": {
      "schema": "#/entities/Client",
      "description": "Stores client records."
    },
    "/tasks/{taskId}": {
      "schema": "#/entities/Task",
      "description": "Main storage for tasks."
    },
    "/client_task_views/{identifier}/tasks/{taskId}": {
      "schema": "#/entities/Task",
      "description": "Read-only view of tasks for public client portal."
    }
  }
}
