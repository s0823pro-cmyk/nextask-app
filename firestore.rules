
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // 指定された管理者アカウントのみに書き込み権限を付与
    function isAdmin() {
      return isSignedIn() 
        && request.auth.token.email_verified == true 
        && request.auth.token.email == "s0823.pro@gmail.com";
    }

    match /clients/{clientId} {
      allow read, write: if isAdmin();
    }

    match /tasks/{taskId} {
      allow read, write: if isAdmin();
    }

    match /client_task_views/{identifier} {
      allow read: if true;
      
      match /tasks/{taskId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }
  }
}
