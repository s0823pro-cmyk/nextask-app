
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn();
    }

    match /clients/{clientId} {
      allow read, write: if isAdmin();
    }

    match /tasks/{taskId} {
      allow read, write: if isAdmin();
    }

    match /client_task_views/{identifier} {
      allow read: if true;
      
      match /tasks/{taskId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }
  }
}
