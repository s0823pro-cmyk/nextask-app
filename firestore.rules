
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // 管理者は認証されているユーザー全員（Google/匿名含む）
    // 本来はメールアドレス等で絞るべきだが、プロトタイプとして全ユーザーを許可
    function isAdmin() {
      return isSignedIn();
    }

    match /clients/{clientId} {
      allow read, write: if isAdmin();
    }

    match /tasks/{taskId} {
      allow read, write: if isAdmin();
    }

    match /client_task_views/{identifier}/tasks/{taskId} {
      // 共有ポータルは完全公開（認証なしで読み取り可能）
      allow read: if true;
      // 書き込みは管理人のみ
      allow write: if isAdmin();
    }
  }
}
